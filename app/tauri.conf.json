{
  "productName": "Simple Capture",
  "version": "0.1.0",
  "identifier": "com.simplecapture.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html#/panel",
        "title": "Simple Capture",
        "width": 380,
        "height": 620,
        "resizable": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "onboarding",
        "url": "index.html#/onboarding",
        "title": "Simple Capture Permissions",
        "width": 520,
        "height": 420,
        "resizable": false,
        "visible": false,
        "focus": false,
        "hiddenTitle": true
      },
      {
        "label": "bar",
        "url": "index.html#/bar",
        "title": "Simple Capture Recording",
        "width": 420,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "switcher",
        "url": "index.html#/switcher",
        "title": "Switch Source",
        "width": 360,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "region",
        "url": "index.html#/region",
        "title": "Select Region",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "pick",
        "url": "index.html#/pick",
        "title": "Pick Source",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "saved",
        "url": "index.html#/saved",
        "title": "Recording Saved",
        "width": 420,
        "height": 300,
        "resizable": false,
        "visible": false,
        "focus": false,
        "hiddenTitle": true
      },
      {
        "label": "stage",
        "url": "index.html#/stage",
        "title": "Preview",
        "width": 560,
        "height": 360,
        "minWidth": 240,
        "minHeight": 160,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#111111"
      },
      {
        "label": "editor",
        "url": "index.html#/editor",
        "title": "Simple Capture Editor",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "focus": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#000000"
      },
      {
        "label": "library",
        "url": "index.html#/library",
        "title": "Simple Capture Library",
        "width": 900,
        "height": 620,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "focus": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "diagnostics",
        "url": "index.html#/diagnostics",
        "title": "Simple Capture Diagnostics",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "focus": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "about",
        "url": "index.html#/about",
        "title": "About Simple Capture",
        "width": 560,
        "height": 620,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "focus": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' sc: http://sc.localhost data: blob:; media-src 'self' sc: http://sc.localhost blob:; font-src 'self' sc: http://sc.localhost; connect-src ipc: http://ipc.localhost sc: http://sc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

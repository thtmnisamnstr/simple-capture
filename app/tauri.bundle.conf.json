{
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/gifski"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "macos/entitlements.plist",
      "infoPlist": "macos/Info.bundle.plist",
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "../assets/fonts/": "fonts/",
      "gen/licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0",
          "xdg-desktop-portal"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

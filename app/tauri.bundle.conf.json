{
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/sc-ffmpeg",
      "binaries/sc-ffprobe",
      "binaries/sc-gifski"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "macos/entitlements.plist",
      "infoPlist": "macos/Info.bundle.plist",
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "../assets/fonts/": "fonts/",
      "gen/licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Video",
    "shortDescription": "Record your screen, camera and voice, edit, and export. Everything stays on this computer.",
    "copyright": "Copyright © 2026 Gavin Johnson. MIT License; the bundled export helpers are GPL/AGPL."
  }
}

#!/bin/sh
# Strict confinement gives the app its own $XDG_RUNTIME_DIR (/run/user/UID/snap.simple-capture);
# PipeWire's socket stays in the user's real one, which the audio interfaces let the app reach.
if [ -z "${PIPEWIRE_RUNTIME_DIR:-}" ] && [ ! -S "${XDG_RUNTIME_DIR:-}/pipewire-0" ]; then
  export PIPEWIRE_RUNTIME_DIR="/run/user/$(id -u)"
fi
triplet=$(ls -d "$SNAP"/usr/lib/*-linux-gnu 2>/dev/null | head -n 1)
[ -n "$triplet" ] && export GST_PLUGIN_PATH="$triplet/gstreamer-1.0${GST_PLUGIN_PATH:+:$GST_PLUGIN_PATH}"
exec "$@"

# Maintainer: Gavin Johnson <https://github.com/thtmnisamnstr>
# Generated by packaging/aur/update.sh from the release's .deb files; edit PKGBUILD.in instead.
pkgname=simple-capture-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Record your screen, camera and voice, edit, and export. Everything stays on this computer."
arch=('x86_64' 'aarch64')
url="https://github.com/thtmnisamnstr/simple-capture"
license=('MIT' 'GPL-2.0-or-later' 'AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'pipewire' 'alsa-lib' 'libayatana-appindicator' 'gst-plugins-base'
         'gst-plugins-good' 'xdg-desktop-portal' 'hicolor-icon-theme')
optdepends=('gst-plugins-bad: VA-API and OpenH264 encoders for the screen track'
            'xdg-desktop-portal-gnome: the screen picker on GNOME'
            'xdg-desktop-portal-kde: the screen picker on KDE Plasma'
            'xdg-desktop-portal-wlr: the screen picker on wlroots compositors')
provides=('simple-capture')
conflicts=('simple-capture')
options=('!strip' '!debug')
source_x86_64=("simple-capture-${pkgver}-amd64.deb::${url}/releases/download/v${pkgver}/simple-capture_${pkgver}_amd64.deb")
source_aarch64=("simple-capture-${pkgver}-arm64.deb::${url}/releases/download/v${pkgver}/simple-capture_${pkgver}_arm64.deb")
sha256sums_x86_64=('@SHA_AMD64@')
sha256sums_aarch64=('@SHA_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 "$pkgdir/usr/lib/simple-capture/licenses/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
